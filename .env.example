# Copy to .env and fill in. Never commit .env.

# Supabase: Project Settings → Database → Connection string → URI
# Use Session pooler (port 5432 on the pooler host), not Transaction (6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Required on Render so /admin updates stay private. Open /admin?token=this-value
ADMIN_TOKEN=change-me
